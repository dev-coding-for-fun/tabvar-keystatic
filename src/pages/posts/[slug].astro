---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');
const post = await getEntry('posts', slug);

if (!post) throw new Error('No post found for this slug');
const { Content } = await render(post);

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id } }));
}
---

<Layout title={`${post.data.title} — TABVAR Bulletin`}>
  <div class="article-hero">
    <div class="container article-container">
      <a href="/posts" class="back-link">&larr; Back to all announcements</a>
      <span class="article-badge">Community Notice</span>
      <h1 class="article-title">{post.data.title}</h1>
      {post.data.coverImage && (
        <div class="article-cover-frame corner-brackets" style="margin-top: 1.5rem; border-radius: 8px; overflow: hidden; max-height: 28rem;">
          <img src={post.data.coverImage} alt={post.data.coverImageAlt || post.data.title} style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
      )}
    </div>
  </div>

  <div class="container article-container article-body-wrap">
    <article class="prose-content">
      <Content />
    </article>

    <div class="article-footer-nav">
      <a href="/posts" class="btn btn-secondary">&larr; All Bulletins</a>
      <a href="/donate" class="btn btn-primary">Support Fixed Hardware</a>
    </div>
  </div>
</Layout>

<style is:global>
  .article-hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--spacing-4xl) var(--spacing-lg);
  }

  .article-container {
    max-width: 48rem;
    margin: 0 auto;
  }

  .back-link {
    font-size: var(--font-size-sm);
    color: var(--color-brand);
    font-weight: 600;
    display: inline-block;
    margin-bottom: var(--spacing-lg);
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .article-badge {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    display: block;
    margin-bottom: var(--spacing-xs);
  }

  .article-title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-display);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    line-height: var(--leading-tight);
  }

  .article-body-wrap {
    padding: var(--spacing-4xl) var(--spacing-lg);
  }

  .prose-content {
    font-size: var(--font-size-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .prose-content p {
    margin-bottom: var(--spacing-lg);
  }

  .prose-content h2 {
    font-size: var(--font-size-2xl);
    margin: var(--spacing-3xl) 0 var(--spacing-md);
  }

  .prose-content h3 {
    font-size: var(--font-size-xl);
    margin: var(--spacing-2xl) 0 var(--spacing-sm);
  }

  .prose-content ul,
  .prose-content ol {
    margin-bottom: var(--spacing-lg);
    padding-left: var(--spacing-xl);
  }

  .prose-content li {
    margin-bottom: var(--spacing-xs);
  }

  .prose-content code {
    background: var(--color-surface-alt);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
    color: var(--color-brand);
  }

  .article-footer-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--spacing-3xl);
    margin-top: var(--spacing-3xl);
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }
</style>
